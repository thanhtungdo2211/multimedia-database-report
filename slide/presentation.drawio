        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n    %% =========================\n    %% OFFLINE GALLERY PIPELINE\n    %% =========================\n\n    subgraph OFFLINE[\&quot;OFFLINE STAGE · GALLERY FEATURE EXTRACTION &amp; INDEXING\&quot;]\n        direction LR\n\n        IMG[\&quot;Gallery Person Images&lt;br/&gt;────────────&lt;br/&gt;I₁, I₂, ..., Iₙ&lt;br/&gt;&lt;br/&gt;Person images captured&lt;br/&gt;from surveillance cameras\&quot;]\n\n        PRE[\&quot;Image Pre-processing&lt;br/&gt;────────────&lt;br/&gt;• Resize / Crop&lt;br/&gt;• Normalize pixels&lt;br/&gt;• Data transformation\&quot;]\n\n        ENC[\&quot;Visual Encoder fᵥ(·)&lt;br/&gt;────────────&lt;br/&gt;CLIP Image Encoder&lt;br/&gt;ViT / ResNet Backbone&lt;br/&gt;&lt;br/&gt;Extract visual semantics\&quot;]\n\n        EMB[\&quot;Visual Embeddings&lt;br/&gt;────────────&lt;br/&gt;vᵢ = fᵥ(Iᵢ)&lt;br/&gt;&lt;br/&gt;vᵢ ∈ ℝᵈ\&quot;]\n\n        NORM[\&quot;L2 Normalization&lt;br/&gt;────────────&lt;br/&gt;v̂ᵢ = vᵢ / ||vᵢ||₂&lt;br/&gt;&lt;br/&gt;Project features onto&lt;br/&gt;unit hypersphere\&quot;]\n\n        INDEX[\&quot;Gallery Vector Index&lt;br/&gt;────────────&lt;br/&gt;{v̂₁, v̂₂, ..., v̂ₙ}&lt;br/&gt;&lt;br/&gt;FAISS / Vector DB&lt;br/&gt;ANN Search Index\&quot;]\n\n        META[\&quot;Gallery Metadata&lt;br/&gt;────────────&lt;br/&gt;• Image ID&lt;br/&gt;• Person ID&lt;br/&gt;• Camera ID&lt;br/&gt;• Image path&lt;br/&gt;• Timestamp\&quot;]\n\n        IMG --&gt; PRE\n        PRE --&gt; ENC\n        ENC --&gt; EMB\n        EMB --&gt; NORM\n        NORM --&gt; INDEX\n        META -. associated metadata .-&gt; INDEX\n    end\n\n    %% =========================\n    %% STYLE\n    %% =========================\n\n    classDef input fill:#EAF4FC,stroke:#2878B5,stroke-width:2px,color:#174E78,font-weight:bold;\n    classDef process fill:#E5F0FA,stroke:#2878B5,stroke-width:2px,color:#174E78,font-weight:bold;\n    classDef encoder fill:#DCEEFF,stroke:#126EB4,strok
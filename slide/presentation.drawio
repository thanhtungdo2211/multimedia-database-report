        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n    I[\&quot;Input Person Image&lt;br/&gt;384 × 128 × 3\&quot;]\n\n    I --&gt; P[\&quot;Patch Embedding&lt;br/&gt;Conv2D 16 × 16, stride 16&lt;br/&gt;24 × 8 = 192 patches&lt;br/&gt;192 × 768\&quot;]\n\n    P --&gt; CLS[\&quot;Prepend [CLS] Token&lt;br/&gt;193 × 768\&quot;]\n\n    CLS --&gt; POS[\&quot;Add Learnable&lt;br/&gt;Positional Embedding\&quot;]\n\n    POS --&gt; PRE[\&quot;Pre-LayerNorm&lt;br/&gt;LN_pre\&quot;]\n\n    PRE --&gt; X\n\n    subgraph B[\&quot;CLIP ViT-B/16 Transformer Encoder — 12 Blocks\&quot;]\n        direction TB\n\n        X[\&quot;Token Sequence X&lt;br/&gt;193 × 768\&quot;]\n\n        X --&gt; LN1[\&quot;LayerNorm\&quot;]\n        LN1 --&gt; MSA[\&quot;Multi-Head Self-Attention&lt;br/&gt;12 Heads\&quot;]\n\n        X --&gt; ADD1((\&quot;＋\&quot;))\n        MSA --&gt; ADD1\n\n        ADD1 --&gt; XP[\&quot;X′\&quot;]\n\n        XP --&gt; LN2[\&quot;LayerNorm\&quot;]\n\n        LN2 --&gt; FC1[\&quot;Linear&lt;br/&gt;768 → 3072\&quot;]\n        FC1 --&gt; GELU[\&quot;QuickGELU\&quot;]\n        GELU --&gt; FC2[\&quot;Linear&lt;br/&gt;3072 → 768\&quot;]\n\n        XP --&gt; ADD2((\&quot;＋\&quot;))\n        FC2 --&gt; ADD2\n\n        ADD2 --&gt; XO[\&quot;Block Output X″&lt;br/&gt;193 × 768\&quot;]\n    end\n\n    XO --&gt; POST[\&quot;Post LayerNorm&lt;br/&gt;LN_post\&quot;]\n\n    POST --&gt; PROJ[\&quot;Visual Projection&lt;br/&gt;768 → 512\&quot;]\n\n    PROJ --&gt; TOK[\&quot;Projected Visual Tokens&lt;br/&gt;193 × 512\&quot;]\n\n    TOK --&gt; G[\&quot;[CLS] Token&lt;br/&gt;Global Image Embedding fᵥ&lt;br/&gt;512-D\&quot;]\n\n    TOK --&gt; V[\&quot;Patch Tokens&lt;br/&gt;192 × 512&lt;br/&gt;Visual K,V for IRR&lt;br/&gt;(Training Only)\&quot;]&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KMN39LRTkqJTQuIWga6F-115">

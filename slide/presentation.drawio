      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n    I[\&quot;Input Image&lt;br/&gt;&lt;b&gt;384 × 128 × 3&lt;/b&gt;\&quot;]\n        --&gt; P[\&quot;Patch Embedding&lt;br/&gt;&lt;b&gt;192 Patch Tokens × 768&lt;/b&gt;\&quot;]\n\n    P --&gt; C[\&quot;Token Sequence Construction&lt;br/&gt;Prepend [CLS] Token&lt;br/&gt;+ Positional Embedding\&quot;]\n\n    C --&gt; X\n\n    subgraph TRANS[\&quot;Vision Transformer Encoder — 12 Blocks\&quot;]\n        direction TB\n\n        X[\&quot;Input Tokens&lt;br/&gt;&lt;b&gt;X ∈ ℝᴺˣ⁷⁶⁸&lt;/b&gt;\&quot;]\n\n        X --&gt; LN1[\&quot;LayerNorm\&quot;]\n        LN1 --&gt; MSA[\&quot;Multi-Head Self-Attention&lt;br/&gt;&lt;b&gt;12 Attention Heads&lt;/b&gt;\&quot;]\n\n        X --&gt; R1[\&quot;Residual / Skip Connection\&quot;]\n        MSA --&gt; ADD1((\&quot;＋\&quot;))\n        R1 --&gt; ADD1\n\n        ADD1 --&gt; XP[\&quot;Intermediate Tokens&lt;br/&gt;&lt;b&gt;X′&lt;/b&gt;\&quot;]\n\n        XP --&gt; LN2[\&quot;LayerNorm\&quot;]\n        LN2 --&gt; FFN[\&quot;Feed-Forward Network / MLP&lt;br/&gt;Linear: 768 → 3072&lt;br/&gt;QuickGELU&lt;br/&gt;Linear: 3072 → 768\&quot;]\n\n        XP --&gt; R2[\&quot;Residual / Skip Connection\&quot;]\n        FFN --&gt; ADD2((\&quot;＋\&quot;))\n        R2 --&gt; ADD2\n\n        ADD2 --&gt; XO[\&quot;Transformer Block Output&lt;br/&gt;&lt;b&gt;X″&lt;/b&gt;\&quot;]\n    end\n\n    XO --&gt; NORM[\&quot;Final LayerNorm\&quot;]\n\n    NORM --&gt; PROJ[\&quot;Visual Projection&lt;br/&gt;&lt;b&gt;768 → 512&lt;/b&gt;\&quot;]\n\n    PROJ --&gt; G[\&quot;[CLS] Token&lt;br/&gt;&lt;b&gt;Global Image Embedding fᵥ&lt;/b&gt;&lt;br/&gt;512-D\&quot;]\n\n    NORM --&gt; PATCH[\&quot;Patch Tokens&lt;br/&gt;&lt;b&gt;Local Visual Representations&lt;/b&gt;&lt;br/&gt;Input for IRR\&quot;]&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KMN39LRTkqJTQuIWga6F-37">

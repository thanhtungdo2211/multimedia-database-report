        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n    %% =========================\n    %% ONLINE QUERY PIPELINE\n    %% =========================\n\n    subgraph ONLINE[\&quot;ONLINE STAGE · TEXT-BASED PERSON RETRIEVAL\&quot;]\n        direction LR\n\n        TEXT[\&quot;Natural Language Query&lt;br/&gt;────────────&lt;br/&gt;T&lt;br/&gt;&lt;br/&gt;Example:&lt;br/&gt;&#39;A man wearing a black jacket&lt;br/&gt;and blue jeans&#39;\&quot;]\n\n        TOKEN[\&quot;Text Pre-processing&lt;br/&gt;────────────&lt;br/&gt;• Tokenization&lt;br/&gt;• Padding / Truncation&lt;br/&gt;• Attention Mask\&quot;]\n\n        TENC[\&quot;Text Encoder fₜ(·)&lt;br/&gt;────────────&lt;br/&gt;CLIP Text Transformer&lt;br/&gt;&lt;br/&gt;Extract semantic&lt;br/&gt;text representation\&quot;]\n\n        TEMB[\&quot;Text Embedding&lt;br/&gt;────────────&lt;br/&gt;t = fₜ(T)&lt;br/&gt;&lt;br/&gt;t ∈ ℝᵈ\&quot;]\n\n        TNORM[\&quot;L2 Normalization&lt;br/&gt;────────────&lt;br/&gt;t̂ = t / ||t||₂&lt;br/&gt;&lt;br/&gt;Normalized query&lt;br/&gt;representation\&quot;]\n\n        SEARCH[\&quot;Cross-Modal Similarity Search&lt;br/&gt;────────────&lt;br/&gt;Compare text embedding&lt;br/&gt;with all gallery embeddings&lt;br/&gt;&lt;br/&gt;Cosine Similarity\&quot;]\n\n        SCORE[\&quot;Similarity Scores&lt;br/&gt;────────────&lt;br/&gt;sᵢ = cos(t̂, v̂ᵢ)&lt;br/&gt;&lt;br/&gt;One score for each&lt;br/&gt;gallery image\&quot;]\n\n        RANK[\&quot;Ranking&lt;br/&gt;────────────&lt;br/&gt;Sort similarity scores&lt;br/&gt;in descending order&lt;br/&gt;&lt;br/&gt;s₁ ≥ s₂ ≥ ... ≥ sₙ\&quot;]\n\n        TOPK[\&quot;Top-k Retrieval&lt;br/&gt;────────────&lt;br/&gt;Select k most relevant&lt;br/&gt;gallery candidates\&quot;]\n\n        RESULT[\&quot;Retrieved Person Images&lt;br/&gt;────────────&lt;br/&gt;Rank-1 · Rank-2 · ... · Rank-k&lt;br/&gt;&lt;br/&gt;Person images most relevant&lt;br/&gt;to the text description\&quot;]\n\n        TEXT --&gt; TOKEN\n        TOKEN --&gt; TENC\n        TENC --&gt; TEMB\n        TEMB --&gt; TNORM\n        TNORM --&gt; SEARCH\n        SEARCH --&gt; SCORE\n        SCORE --&gt; RANK\n        RANK --&gt; TOPK\n        TOPK --&gt; RESULT\n    end\n\n    classDef input fill:#FFF0F1,stroke:#DC3545,stroke-width:2px,color:#9D1024,font-weight:bold;\n    classDef process fill:#FFF4F4,stroke:#E35D6A,stroke-width:2px,color:#9D1024,font-weight:bold;\n    classDef encoder fill:#FFE5E8,stroke:#CF1830,stroke-width:3px,color:#970B20,font-weight:bold;\n    classDef embedding fill:#FFF1F2,stroke:#DC5362,stroke-width:2px,color:#9D1024,font-weight:bold;\n    classDef search fill:#F4F5F7,stroke:#6C757D,stroke-width:2.5px,color:#343A40,font-weight:bold;\n    classDef result fill:#EAF8EE,stroke:#3C9D5D,stroke-width:2.5px,color:#226B39,font-weight:bold;\n\n    class TEXT input;\n    class TOKEN process;\n    class TENC encoder;\n    class TEMB,TNORM embedding;\n    class SEARCH,SCORE,RANK,TOPK search;\n    class RESULT result;\n\n    style ONLINE fill:#FFFAFA,stroke:#CF1830,stroke-width:2px&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wBjziYkDFL9zfB2QDVKj-16">
